# Add your Gemini API key to backend/.env (never put it in frontend files).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
MEVAA_GEMINI_MODEL=gemini-2.5-flash

# Set a private, hard-to-guess value before using GET /api/inquiries.
INQUIRY_ADMIN_TOKEN=change-this-to-a-long-private-token

# In production, replace * with the full origin of your website.
CORS_ORIGINS=*

# Optional SQLite file path. By default this is backend/inquiries.db.
# INQUIRY_DATABASE=
